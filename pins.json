    "librespeed-go-h2": {
      "variantOf": "librespeed-go",
      "name": "LibreSpeed Go backend, HTTP/2",
      "browsers": [
        "chrome"
      ],
      "onlyScenarios": [
        "accuracy-1000",
        "loss-1000",
        "accuracy-10000",
        "accuracy-25000",
        "accuracy-40000"
      ],
      "tls": {
        "mount": "/certs",
        "env": {}
      },
      "url": "https://{host}:8989/",
      "configFile": {
        "source": "release:settings.toml",
        "target": "/config/settings.toml",
        "edits": [
          [
            "enable_tls=false",
            "enable_tls=true"
          ],
          [
            "enable_http2=false",
            "enable_http2=true"
          ],
          [
            "# tls_cert_file=\"cert.pem\"",
            "tls_cert_file=\"/certs/cert.pem\""
          ],
          [
            "# tls_key_file=\"privkey.pem\"",
            "tls_key_file=\"/certs/key.pem\""
          ]
        ]
      },
      "command": [
        "./speedtest-backend",
        "-c",
        "/config/settings.toml"
      ],
      "reports": {
        "quantity": "payload",
        "evidence": "settings.toml v1.1.6: TLS and HTTP/2 settings, TLS is required for HTTP/2"
      },
      "expectProtocol": "2"
    },
    "openspeedtest-h2": {
      "variantOf": "openspeedtest",
      "name": "OpenSpeedTest, HTTP/2",
      "browsers": [
        "chrome"
      ],
      "onlyScenarios": [
        "accuracy-1000",
        "loss-1000",
        "accuracy-10000",
        "accuracy-25000",
        "accuracy-40000"
      ],
      "tls": {
        "mount": "/etc/ssl",
        "env": {}
      },
      "url": "https://{host}:3001/",
      "port": 3001,
      "configFile": {
        "source": "image:/etc/nginx/conf.d/OpenSpeedTest-Server.conf",
        "target": "/etc/nginx/conf.d/OpenSpeedTest-Server.conf",
        "edits": [
          [
            "listen 3001 ssl reuseport;",
            "listen 3001 ssl http2 reuseport;"
          ],
          [
            "listen [::]:3001 ssl reuseport;",
            "listen [::]:3001 ssl http2 reuseport;"
          ],
          [
            "       #location = /upload {",
            "       location = /upload {"
          ],
          [
            "       #    proxy_pass http://127.0.0.1:3000/dev-null;",
            "           proxy_pass http://127.0.0.1:3000/dev-null;"
          ],
          [
            "       #location = /dev-null {",
            "       location = /dev-null {"
          ],
          [
            "       #    return 200;",
            "           return 200;"
          ],
          [
            "       #}",
            "       }"
          ]
        ]
      },
      "reports": {
        "quantity": "payload",
        "evidence": "OpenSpeedTest-Server.conf in the image: add http2 to the TLS listen line and enable the HTTP2 & HTTP3 upload fix"
      },
      "expectProtocol": "2"
    }
