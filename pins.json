{
  "tools": {
    "graphite-meter": {
      "name": "Graphite Meter",
      "version": "0.13.4",
      "image": "ghcr.io/zr-jb/graphite-meter:0.13.4@sha256:a09e39bc4203c85779b53cad3aa6d45a9ea841630f3149a36faa584d52c6fff0",
      "port": 7246,
      "env": {},
      "source": "https://github.com/zR-JB/graphite-meter",
      "quickStart": "docker run -d --name graphite-meter --restart unless-stopped -p 7246:7246 ghcr.io/zr-jb/graphite-meter:latest",
      "reports": {
        "quantity": "payload",
        "evidence": "docs/MEASUREMENTS.md: payload bytes per second; the wire-rate estimate is shown separately"
      },
      "proxy": {
        "evidence": "docs/DEPLOYMENT.md, Reverse proxies and nginx",
        "env": {
          "GM_ADVERTISED_NATIVE_ENDPOINTS": "none",
          "GM_PUBLIC_ORIGINS": "self",
          "GM_TRUSTED_PROXIES": "127.0.0.1/32"
        },
        "location": [
          "proxy_set_header Upgrade $http_upgrade;",
          "proxy_set_header Connection $connection_upgrade;",
          "proxy_set_header X-Real-IP $remote_addr;",
          "proxy_set_header X-Forwarded-Proto $scheme;",
          "proxy_set_header X-Forwarded-Host $http_host;",
          "proxy_buffering off;",
          "proxy_request_buffering off;",
          "proxy_read_timeout 300s;",
          "proxy_send_timeout 300s;",
          "client_max_body_size 0;"
        ]
      },
      "watch": {
        "github": "zR-JB/graphite-meter",
        "image": "ghcr.io/zr-jb/graphite-meter:{version}"
      },
      "multiServer": {
        "evidence": "docs/REFERENCE.md, Server catalog: GM_SERVER_CATALOG with defaultSelection",
        "env": {
          "GM_SERVER_CATALOG": "{\"defaultSelection\": [\"self\", \"second\"], \"servers\": [{\"id\": \"second\", \"name\": \"Second\", \"url\": \"http://10.71.3.10:7246\"}]}"
        }
      }
    },
