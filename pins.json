    "graphite-meter-h2": {
      "variantOf": "graphite-meter",
      "name": "Graphite Meter, HTTP/2",
      "browsers": [
        "chrome"
      ],
      "onlyScenarios": [
        "accuracy-1000",
        "loss-1000",
        "accuracy-10000",
        "accuracy-25000",
        "accuracy-40000"
      ],
      "tls": {
        "mount": "/certs",
        "env": {
          "GM_H2_ADDR": ":7248",
          "GM_H3_ADDR": ":7249",
          "GM_TLS_CERT": "/certs/cert.pem",
          "GM_TLS_KEY": "/certs/key.pem",
          "GM_H2_PUBLIC_ORIGIN": "https://{host}:7248",
          "GM_H3_PUBLIC_ORIGIN": "https://{host}:7249",
          "GM_H1_TLS_ADDR": ":7247",
          "GM_H1_TLS_PUBLIC_ORIGIN": "https://{host}:7247"
        }
      },
      "options": {
        "config": {
          "transports": {
            "throughputTarget": "protocol:http2",
            "latencyTarget": "transport:websocket"
          }
        }
      },
      "reports": {
        "quantity": "payload",
        "evidence": "docs/DEPLOYMENT.md, Native listeners; the browser's connection path setting (client/src/engine/types.ts)"
      },
      "url": "https://{host}:7247/"
    },
